			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Text only: Wingman reads the chat on your phone and sends just the text. Cheapest. Text + Screenshot also sends the picture, which helps with photos, stickers and emoji-only messages. If the phone cannot read a screen, the screenshot is sent automatically either way.</string>
