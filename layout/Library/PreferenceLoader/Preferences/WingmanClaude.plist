			<string>com.adarsh.wingman</string>
			<key>key</key>
			<string>claudeAPIKey</string>
			<key>label</key>
			<string>API Key</string>
			<key>noAutoCorrect</key>
			<true/>
			<key>placeholder</key>
			<string>sk-ant-...</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
